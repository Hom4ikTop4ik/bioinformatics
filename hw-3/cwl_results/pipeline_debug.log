with open(sys.argv[1]) as f:
    content = f.read()
match = re.search(r'"'"'(\d+)\s+\+\s+0\s+mapped\s+\((\d+\.?\d*)%'"'"', content)
if match:
    percent = float(match.group(2))
    ok = int(sys.argv[2])
    pot = int(sys.argv[3])
    if percent >= ok:
        status = "OK"
    elif percent >= pot:
        status = "pot OK"
    else:
        status = "FAIL"
    # Записываем статус
