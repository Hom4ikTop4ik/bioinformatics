        out.write(f"{status}\n")
    # Записываем процент
    with open("mapping_percent.txt", "w") as out:
        out.write(f"{percent}\n")
else:
    with open("status.txt", "w") as out:
        out.write("ERROR\n")
    with open("mapping_percent.txt", "w") as out:
        out.write("0\n")
    sys.exit(1)
